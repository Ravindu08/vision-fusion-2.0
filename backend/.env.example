PROJECT_NAME="Vision Fusion 2.0 – Tech Career Week"
API_V1_STR="/api/v1"
SECRET_KEY="visionfusion2_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration (defaults to local postgres)
# Can fall back to SQLite sqlite:///./vision_fusion.db if Postgres is not configured locally
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/vision_fusion"
SQLITE_FALLBACK_URL="sqlite:///./vision_fusion.db"

# Gamification Constants
TOTAL_POSSIBLE_XP=1000
CERTIFICATE_THRESHOLD_PERCENT=35.0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

